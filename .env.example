# Application
APP_NAME=FastAPI Template
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# PostgreSQL connection used by the application and Alembic.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
DATABASE_ECHO=false

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_SECRET_KEY=replace-with-a-different-32-character-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Set ADMIN_ENABLED=false when the SQLAdmin UI is not needed.
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# JSON arrays. Restrict both values in production.
CORS_ORIGINS=[]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
